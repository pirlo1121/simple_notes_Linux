{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickNotes",
  "mainBinaryName": "quicknotes",
  "version": "0.1.0",
  "identifier": "dev.quicknotes.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuickNotes",
        "width": 440,
        "height": 700,
        "minWidth": 340,
        "minHeight": 320,
        "center": false,
        "decorations": false,
        "visible": false,
        "resizable": true,
        "transparent": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "Notas rápidas, sin distracciones",
    "longDescription": "Captura ideas en segundos con Super+N. Notas en Markdown en ~/.quicknotes, búsqueda instantánea, etiquetas, notas fijadas e historial.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "section": "utils",
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "files": {
          "/usr/share/quicknotes/setup-shortcut.sh": "../packaging/setup-shortcut.sh"
        }
      }
    }
  }
}
